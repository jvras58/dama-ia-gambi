# Copie para .env e ajuste. Todos os valores abaixo são os padrões de src/dama/config.py.

# --- Gambi ---
DAMA_GAMBI_HUB=http://localhost:3000
DAMA_GAMBI_SALA=
DAMA_GAMBI_CHAVE_API=gambi
DAMA_GAMBI_MODELO_PADRAO=*

# --- Servidor web ---
DAMA_PORTA=8443

# --- LLM ---
DAMA_LLM_TIMEOUT_S=60
DAMA_LLM_TENTATIVAS=2
DAMA_LLM_ESPERA_OCUPADO_S=2.0
DAMA_LLM_ULTIMOS_LANCES=6
DAMA_LLM_LANCES_DE_CONTINUACAO=4
DAMA_LLM_MOTIVO_MAX=300

# --- Minimax: busca ---
DAMA_MINIMAX_TEMPO_S=1.0
DAMA_MINIMAX_PROFUNDIDADE=8
DAMA_MINIMAX_PONTUACAO_VITORIA=10000
DAMA_MINIMAX_MARGEM_VITORIA=1000
DAMA_MINIMAX_INFINITO=1000000
DAMA_MINIMAX_NOS_ENTRE_RELOGIO=512

# --- Minimax: avaliação (centésimos de pedra) ---
DAMA_AVALIACAO_VALOR_PEDRA=100
DAMA_AVALIACAO_VALOR_DAMA=300
DAMA_AVALIACAO_PESO_AVANCO=3
DAMA_AVALIACAO_PESO_CENTRO=5
DAMA_AVALIACAO_PESO_MOBILIDADE=2
DAMA_AVALIACAO_PESO_AMEACA=15
DAMA_AVALIACAO_PESO_ULTIMA_FILEIRA=6

# --- Juiz: rótulos dos lances (centésimos de pedra) ---
DAMA_JUIZ_LIMITE_BOM=30
DAMA_JUIZ_LIMITE_DUVIDOSO=100
DAMA_JUIZ_PERDA_MAXIMA=450

# --- Regras ---
DAMA_REGRAS_LIMITE_LANCES_DE_DAMA=20

# --- Simulação no terminal ---
DAMA_SIMULACAO_BRANCAS=llm:*
DAMA_SIMULACAO_PRETAS=minimax
DAMA_SIMULACAO_MAX_LANCES=300
DAMA_SIMULACAO_MOTIVO_MAX=70
DAMA_PASTA_PARTIDAS=dados/partidas
DAMA_CHECAGEM_AMOSTRA_MAX=20

# --- Visão e captura ---
DAMA_VISAO_FRAMES_ESTAVEIS=5
DAMA_VISAO_CONFIANCA_MIN=0.6
DAMA_CAPTURA_TIMEOUT_S=15
DAMA_GRAVAR_FRAMES=false
